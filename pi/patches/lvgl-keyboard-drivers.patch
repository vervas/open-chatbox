diff --git a/src/drivers/libinput/lv_xkb.c b/src/drivers/libinput/lv_xkb.c
index 1e8ddb10c..a5bddaf5d 100644
--- a/src/drivers/libinput/lv_xkb.c
+++ b/src/drivers/libinput/lv_xkb.c
@@ -91,11 +91,11 @@ uint32_t lv_xkb_process_key(lv_xkb_t * dsc, uint32_t scancode, bool down)
             break;
         case XKB_KEY_Prior:
         case XKB_KEY_KP_Prior:
-            result = LV_KEY_PREV;
+            result = 0x05;  /* custom: emoji page up */
             break;
         case XKB_KEY_Next:
         case XKB_KEY_KP_Next:
-            result = LV_KEY_NEXT;
+            result = 0x06;  /* custom: emoji page down */
             break;
         case XKB_KEY_Up:
         case XKB_KEY_KP_Up:
@@ -128,6 +128,16 @@ uint32_t lv_xkb_process_key(lv_xkb_t * dsc, uint32_t scancode, bool down)
         case XKB_KEY_KP_End:
             result = LV_KEY_END;
             break;
+        case XKB_KEY_Escape:
+            result = LV_KEY_ESC;
+            break;
+        case XKB_KEY_Menu:
+            result = 0x04;  /* custom: emoji toggle */
+            break;
+        case XKB_KEY_Super_L:
+        case XKB_KEY_Super_R:
+            result = 0x04;  /* custom: emoji toggle (Windows key) */
+            break;
         default:
             break;
     }
diff --git a/src/drivers/sdl/lv_sdl_keyboard.c b/src/drivers/sdl/lv_sdl_keyboard.c
index 0bb94d6e3..3eb64ce5b 100644
--- a/src/drivers/sdl/lv_sdl_keyboard.c
+++ b/src/drivers/sdl/lv_sdl_keyboard.c
@@ -198,11 +198,13 @@ static uint32_t keycode_to_ctrl_key(SDL_Keycode sdl_key)
             return LV_KEY_ENTER;
 
         case SDLK_TAB:
-        case SDLK_PAGEDOWN:
             return LV_KEY_NEXT;
 
+        case SDLK_PAGEDOWN:
+            return 0x06;  /* custom: emoji page down */
+
         case SDLK_PAGEUP:
-            return LV_KEY_PREV;
+            return 0x05;  /* custom: emoji page up */
 
         case SDLK_HOME:
             return LV_KEY_HOME;
@@ -210,6 +212,11 @@ static uint32_t keycode_to_ctrl_key(SDL_Keycode sdl_key)
         case SDLK_END:
             return LV_KEY_END;
 
+        case SDLK_MENU:
+        case SDLK_LGUI:
+        case SDLK_RGUI:
+            return 0x04;  /* custom: emoji toggle */
+
         default:
             return '\0';
     }
